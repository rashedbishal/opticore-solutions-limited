APP_NAME=Laravel
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=opticoresolutions
DB_USERNAME=postgres
DB_PASSWORD=password

DB_ADMIN_HOST=127.0.0.1
DB_ADMIN_PORT=5432
DB_ADMIN_DATABASE=opticoresolutions_admin
DB_ADMIN_USERNAME=postgres
DB_ADMIN_PASSWORD=password

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Forced to true in production regardless of this value (see AppServiceProvider).
# Leave unset/false locally so cookies still work over plain http://localhost.
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

# Reverb — only required when BROADCAST_CONNECTION=reverb.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=127.0.0.1
REVERB_HOSTNAME="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="localhost"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI="${APP_URL}/auth/facebook/callback"

EXCHANGE_RATE_API_KEY=

# AI chat widget — GROQ_API_KEY is what ChatController actually calls for
# fallback replies. GEMINI_API_KEY exists alongside the installed Gemini
# SDK but isn't currently called from app/.
GEMINI_API_KEY=
GROQ_API_KEY=

SSLCZ_STORE_ID=
SSLCZ_STORE_PASSWORD=
SSLCZ_TESTMODE=false

# Browsershot (spatie/laravel-pdf) — path to Chrome on the server. "node"/"npm"
# are resolved via PATH by default, which covers CI (actions/setup-node) and
# most servers. Only uncomment NODE_BINARY/NPM_BINARY below if PDF generation
# fails with "node: not found" / "npm: not found" (e.g. a web server process
# whose PATH doesn't include them) — point them at `which node` / `which npm`.
LARAVEL_PDF_CHROME_PATH=/usr/bin/google-chrome-stable
# LARAVEL_PDF_NODE_BINARY=/usr/bin/node
# LARAVEL_PDF_NPM_BINARY=/usr/bin/npm
# LARAVEL_PDF_NO_SANDBOX=true

VITE_APP_NAME="${APP_NAME}"
